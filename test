#!/usr/bin/env python3
"""./test             show every ls/copy command on a fake session, then run all tests
./test --examples  also rewrite docs/examples.md from that same run

Everything runs on fake data with a recorded clipboard: your own clipboard is never touched.
This does not prove what a real Claude Code or Codex session does; that is the release checklist."""
import sys
import unittest
from pathlib import Path

if sys.version_info < (3, 10):
    sys.exit("Python 3.10 or newer is required.")
ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
from tests import scenario  # noqa: E402


def main() -> int:
    results, stored = scenario.run("claude"), scenario.run_stored("claude")
    text = scenario.render(results, stored)
    if "--examples" in sys.argv[1:]:
        (ROOT / "docs").mkdir(exist_ok=True)
        (ROOT / "docs/examples.md").write_text(text, encoding="utf-8")
        print("Wrote docs/examples.md\n", flush=True)
    print(scenario.render_terminal(results, stored))
    print("Running all tests...", flush=True)
    suite = unittest.defaultTestLoader.discover(str(ROOT / "tests"))  # same as: python3 -m unittest discover -s tests
    ok = unittest.TextTestRunner(stream=sys.stdout, verbosity=1).run(suite).wasSuccessful()  # one stream, one order
    print("\nALL TESTS PASSED" if ok else "\nTESTS FAILED", flush=True)
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
